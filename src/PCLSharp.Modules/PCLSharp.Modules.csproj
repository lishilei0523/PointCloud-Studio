<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;netstandard2.0</TargetFrameworks>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Description>SD.Framework PCL模块</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Content\Package.targets">
      <Pack>True</Pack>
      <PackagePath>build\$(PackageId).targets</PackagePath>
    </None>
    <None Include="$(SolutionDir)\bin\$(Configuration)\PCLSharp.Modules.Native.dll">
      <Visible>False</Visible>
      <Pack>True</Pack>
      <PackagePath>build\win-x64\</PackagePath>
    </None>
    <None Include="$(SolutionDir)\bin\libPCLSharp.Modules.Native.so">
      <Visible>False</Visible>
      <Pack>True</Pack>
      <PackagePath>build\linux-x64\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(SolutionDir)\bin\$(Configuration)\PCLSharp.Modules.Native.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Visible>False</Visible>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)\bin\libPCLSharp.Modules.Native.so" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Visible>False</Visible>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCLSharp.Primitives\PCLSharp.Primitives.csproj" />
  </ItemGroup>
</Project>
