<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;netstandard2.0</TargetFrameworks>
    <LangVersion>8.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>SD.Framework PCL基元</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Content\Package.targets">
      <Pack>True</Pack>
      <PackagePath>build\$(PackageId).targets</PackagePath>
    </None>
    <None Include="$(SolutionDir)\bin\$(Configuration)\PCLSharp.Primitives.Native.dll">
      <Visible>False</Visible>
      <Pack>True</Pack>
      <PackagePath>build\win-x64\</PackagePath>
    </None>
    <None Include="$(SolutionDir)\bin\libPCLSharp.Primitives.Native.so">
      <Visible>False</Visible>
      <Pack>True</Pack>
      <PackagePath>build\linux-x64\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(SolutionDir)\bin\$(Configuration)\PCLSharp.Primitives.Native.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Visible>False</Visible>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)\bin\libPCLSharp.Primitives.Native.so" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Visible>False</Visible>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
</Project>
